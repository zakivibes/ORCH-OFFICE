{
  "name": "orch-office",
  "version": "0.1.0",
  "description": "ORCH OFFICE: persistent multi-agent orchestrator. Drive claude, agy and opencode worker sessions from Claude Code over MCP, and watch them in a pixel office.",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/main.ts",
    "mcp": "tsx src/mcp/run.ts",
    "test": "npm run build:test && node --test \"dist-test/test/*.test.js\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build:test": "tsc -p tsconfig.test.json",
    "office": "node office/server.mjs",
    "office:demo": "node office/demo-db.mjs && ORCH_DB=/tmp/orch-office-demo.db node office/server.mjs"
  },
  "keywords": [
    "mcp",
    "claude-code",
    "ai-agents",
    "orchestrator",
    "multi-agent",
    "opencode",
    "gemini",
    "antigravity",
    "llm"
  ],
  "author": "Abdullah Zaki",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "type": "module",
  "bin": {
    "orch": "dist/cli/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zakivibes/ORCH-OFFICE-.git"
  },
  "homepage": "https://github.com/zakivibes/ORCH-OFFICE-#readme"
}
